@page
@model AboutModel
@{
    ViewData["Title"] = "About this demo";
}

<article aria-labelledby="about-heading">
    <h1 id="about-heading">About this demo</h1>

    <section aria-labelledby="what-heading">
        <h2 id="what-heading">What this app demonstrates</h2>
        <p>
            Parts Unlimited is a sample .NET 8 storefront used to demonstrate
            AI-assisted development and delivery.
        </p>
    </section>

    <section aria-labelledby="limitations-heading">
        <h2 id="limitations-heading">Demo limitations</h2>
        <p>
            This application is a demonstration only and does not accept
            real orders or payments.
        </p>
    </section>
</article>