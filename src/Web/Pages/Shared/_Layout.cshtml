<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Parts Unlimited</title>
    <style>
        .skip-link {
            position: absolute;
            top: -3rem;
            left: 0;
            z-index: 1000;
            padding: 0.75rem 1rem;
            color: #fff;
            background: #000;
        }

        .skip-link:focus {
            top: 0;
        }
    </style>
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer>
        @* User Story: "Refresh the footer with the current year and key links" (year is dynamic). *@
        <p>&copy; @DateTime.UtcNow.Year Parts Unlimited &middot;
            <a href="/privacy">Privacy</a> &middot;
            <a href="/contact">Contact</a>
        </p>
    </footer>
</body>
</html>
